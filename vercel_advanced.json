{
  "version": 2,
  "builds": [
    {
      "src": "api_handler_full.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "3000mb",
        "maxDuration": 900,
        "memory": 3008
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api_handler_full.py"
    }
  ],
  "env": {
    "TELEGRAM_BOT_TOKEN": "@telegram_bot_token",
    "WEBHOOK_URL": "@webhook_url"
  },
  "buildEnv": {
    "PIP_NO_BINARY": "ffmpeg-python"
  }
}
