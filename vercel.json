{
  "version": 2,
  "rewrites": [
    { "source": "/",        "destination": "/public/index.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "functions": {
    "api/upload.js":  { "maxDuration": 30 },
    "api/webhook.js": { "maxDuration": 10 },
    "api/setup.js":   { "maxDuration": 10 }
  }
}
