{
  "version": 2,
  "builds": [
    {
      "src": "api/handler.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/.*",
      "dest": "api/handler.py"
    },
    {
      "src": "/.*",
      "dest": "api/handler.py"
    }
  ],
  "env": {
    "TELEGRAM_BOT_TOKEN": "@telegram_bot_token",
    "WEBHOOK_URL": "@webhook_url"
  }
}
